\
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /*
         * Binding order:
         * K1 K2 K3
         * K4 K5 K6
         * K7 K8 K9
         * K10 K11 K12
         * Encoder push
         */

        office {
            display-name = "Office";

            bindings = <
                &kp LC(C)       &kp LC(V)       &kp LC(X)
                &kp LC(Z)       &kp LC(Y)       &kp LC(A)
                &kp LC(S)       &kp LC(F)       &kp ENTER
                &kp BACKSPACE   &kp TAB         &kp ESC
                &to 1
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        media {
            display-name = "Media";

            bindings = <
                &kp C_PLAY_PAUSE   &kp C_PREVIOUS    &kp C_NEXT
                &kp C_MUTE         &kp C_VOL_DN      &kp C_VOL_UP
                &kp C_AC_BACK      &kp C_AC_FORWARD  &kp HOME
                &kp END            &kp PAGE_UP       &kp PAGE_DOWN
                &to 2
            >;

            sensor-bindings = <&inc_dec_kp C_NEXT C_PREVIOUS>;
        };

        fusion {
            display-name = "Fusion 360";

            bindings = <
                &kp LC(Z)       &kp LC(Y)       &kp LC(S)
                &kp LC(C)       &kp LC(V)       &kp DELETE
                &kp F           &kp V           &kp M
                &kp E           &kp L           &kp ESC
                &to 0
            >;

            sensor-bindings = <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };
    };
};
